@page "/"
@rendermode InteractiveServer
@inject GameApiClient Api
@implements IAsyncDisposable

<PageTitle>Game</PageTitle>

<h1 class="h3 mb-3">Game</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="d-grid gap-2 d-sm-flex flex-sm-wrap mb-3">
    <button type="button" class="btn btn-primary" @onclick="CreateGameAsync" disabled="@_busy">New game</button>
    <button type="button" class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
</div>

@if (_games.Count == 0 && !_busy)
{
    <p class="text-muted">No games yet. Create one to get started.</p>
}
else
{
    @* Narrow screens: stacked cards with full-width actions *@
    <div class="d-md-none game-mobile-list">
        @foreach (var g in _games.OrderByDescending(x => x.Id))
        {
            <div class="card mb-3 shadow-sm @(g.Id == _selectedId ? "border border-primary border-2" : "border-0")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div class="min-w-0">
                            <div class="fw-semibold">Game <span class="text-muted">#@g.Id</span></div>
                            <code class="small">@g.Status</code>
                        </div>
                        <span class="badge text-bg-secondary flex-shrink-0">@g.Devices.Count devices</span>
                    </div>
                    <div class="small text-muted text-break mb-3">@g.CreateTime.ToString("u")</div>
                    <div class="d-grid gap-2">
                        <div class="row g-2">
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-primary w-100 py-2" @onclick="() => SelectAsync(g.Id)" disabled="@_busy">Details</button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2" @onclick="() => OpenLobbyAsync(g.Id)" disabled="@(_busy || g.Status != GamePhase.Created)">Lobby</button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-success w-100 py-2" @onclick="() => StartAsync(g.Id)" disabled="@(_busy || g.Status != GamePhase.WaitingForPlayers)">Start</button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-warning w-100 py-2" @onclick="() => FinishAsync(g.Id)" disabled="@(_busy || g.Status != GamePhase.InProgress)">Finish</button>
                            </div>
                            <div class="col-12">
                                <button type="button" class="btn btn-danger w-100 py-2" @onclick="() => DeleteAsync(g.Id)" disabled="@_busy">Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* md+: compact table *@
    <div class="d-none d-md-block table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
            <tr>
                <th>Id</th>
                <th>Status</th>
                <th>Created (UTC)</th>
                <th>Devices</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var g in _games.OrderByDescending(x => x.Id))
            {
                <tr class="@(g.Id == _selectedId ? "table-active" : null)">
                    <td>@g.Id</td>
                    <td><code>@g.Status</code></td>
                    <td>@g.CreateTime.ToString("u")</td>
                    <td>@g.Devices.Count</td>
                    <td class="text-end">
                        <div class="d-flex flex-wrap justify-content-end gap-1">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectAsync(g.Id)" disabled="@_busy">Details</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenLobbyAsync(g.Id)" disabled="@(_busy || g.Status != GamePhase.Created)">Lobby</button>
                            <button type="button" class="btn btn-sm btn-success" @onclick="() => StartAsync(g.Id)" disabled="@(_busy || g.Status != GamePhase.WaitingForPlayers)">Start</button>
                            <button type="button" class="btn btn-sm btn-warning" @onclick="() => FinishAsync(g.Id)" disabled="@(_busy || g.Status != GamePhase.InProgress)">Finish</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(g.Id)" disabled="@_busy">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_selected is not null)
{
    var scoreboard = BuildScoreboard(_selected);
    var leader = scoreboard.FirstOrDefault();
    var trailing = scoreboard.LastOrDefault();
    var totalCombatScore = scoreboard.Sum(x => x.CombatReportScore);
    var scoreSpread = LeaderboardSpread(scoreboard);

    <hr class="my-4"/>
    <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="h4 mb-0">Game @_selected.Id</h2>
        @if (_selected.Status == GamePhase.InProgress)
        {
            <span class="badge text-bg-success d-flex align-items-center gap-1">
                <span class="live-dot"></span> Live
            </span>
        }
    </div>
    <p class="text-muted mb-3">Status: <strong>@_selected.Status</strong></p>

    <div class="scoreboard-dashboard mb-4">
        <div class="row g-2 g-md-3">
            <div class="col-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body py-3">
                        <div class="small text-muted">Top player</div>
                        <div class="fw-semibold text-truncate">@(leader?.PlayerName ?? "-")</div>
                        <div class="small">Battles won: <strong>@(leader?.CombatReportScore ?? 0)</strong></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body py-3">
                        <div class="small text-muted">Trailing player</div>
                        <div class="fw-semibold text-truncate">@(trailing?.PlayerName ?? "-")</div>
                        <div class="small">Battles won: <strong>@(trailing?.CombatReportScore ?? 0)</strong></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body py-3">
                        <div class="small text-muted">Total battles</div>
                        <div class="h5 mb-0">@totalCombatScore</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body py-3">
                        <div class="small text-muted">Score spread</div>
                        <div class="h5 mb-0">@scoreSpread</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (scoreboard.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body pb-2">
                <h3 class="h6 mb-3">Combat Scoreboard</h3>

                <div class="d-md-none">
                    @foreach (var row in scoreboard)
                    {
                        <div class="card mb-2 border scoreboard-rank-border-@Math.Min(row.Rank, 3)">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge text-bg-dark">#@row.Rank</span>
                                            <span class="fw-semibold text-truncate">@row.PlayerName</span>
                                        </div>
                                        <div class="small text-muted mt-1">Device @(row.DeviceId?.ToString() ?? "-")</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="h5 mb-0">@row.CombatReportScore</div>
                                        <div class="small text-muted">battles won</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-none d-md-block table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Player</th>
                            <th>Device</th>
                            <th>Team</th>
                            <th class="text-end">Battles won</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in scoreboard)
                        {
                            <tr>
                                <td><span class="badge text-bg-dark">#@row.Rank</span></td>
                                <td>@row.PlayerName</td>
                                <td>@(row.DeviceId?.ToString() ?? "-")</td>
                                <td>@(row.Team ?? "-")</td>
                                <td class="text-end fw-semibold">@row.CombatReportScore</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (_selected.Devices.Count == 0)
    {
        <p class="text-muted">No devices registered yet.</p>
    }
    else
    {
        <div class="d-md-none">
            @foreach (var d in _selected.Devices.OrderBy(x => x.AddedOn))
            {
                <div class="card mb-2 border-0 shadow-sm">
                    <div class="card-body py-3">
                        <div class="fw-semibold mb-2">@d.PlayerName</div>
                        <dl class="row small mb-0 gx-2">
                            <dt class="col-5 text-muted">Db Id</dt>
                            <dd class="col-7 text-break">@d.Id</dd>
                            <dt class="col-5 text-muted">DeviceId</dt>
                            <dd class="col-7 text-break">@(d.DeviceId?.ToString() ?? "—")</dd>
                            <dt class="col-5 text-muted">Team</dt>
                            <dd class="col-7">@(d.Team ?? "—")</dd>
                            <dt class="col-5 text-muted">Combat score</dt>
                            <dd class="col-7">@(d.CombatScore?.ToString() ?? "—")</dd>
                            <dt class="col-5 text-muted">Enemy flag</dt>
                            <dd class="col-7 text-break">@(d.EnemyFlagId?.ToString() ?? "—")</dd>
                            <dt class="col-5 text-muted">Joined (UTC)</dt>
                            <dd class="col-7 text-break small">@d.AddedOn.ToString("u")</dd>
                        </dl>
                        @if (_selected.Status == GamePhase.WaitingForPlayers)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm w-100 mt-3" @onclick="() => RemoveLobbyPlayerAsync(_selected.Id, d.Id)" disabled="@_busy">Remove from lobby</button>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="d-none d-md-block table-responsive">
            <table class="table table-bordered table-sm">
                <thead>
                <tr>
                    <th>Db Id</th>
                    <th>DeviceId</th>
                    <th>Player</th>
                    <th>Team</th>
                    <th>Combat score</th>
                    <th>Enemy flag</th>
                    <th>Joined (UTC)</th>
                    @if (_selected.Status == GamePhase.WaitingForPlayers)
                    {
                        <th class="text-end">Lobby</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var d in _selected.Devices.OrderBy(x => x.AddedOn))
                {
                    <tr>
                        <td>@d.Id</td>
                        <td>@(d.DeviceId?.ToString() ?? "—")</td>
                        <td>@d.PlayerName</td>
                        <td>@(d.Team ?? "—")</td>
                        <td>@(d.CombatScore?.ToString() ?? "—")</td>
                        <td>@(d.EnemyFlagId?.ToString() ?? "—")</td>
                        <td>@d.AddedOn.ToString("u")</td>
                        @if (_selected.Status == GamePhase.WaitingForPlayers)
                        {
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLobbyPlayerAsync(_selected.Id, d.Id)" disabled="@_busy">Remove</button>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private sealed record ScoreboardRow(int Rank, string PlayerName, byte? DeviceId, string? Team, int CombatReportScore);

    private readonly List<GameListItemDto> _games = [];
    private GameListItemDto? _selected;
    private int? _selectedId;
    private string? _error;
    private bool _busy;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        // Auto-select the first open game (WaitingForPlayers or InProgress)
        if (_selectedId is null && _games.Count > 0)
        {
            var openGame = _games
                .Where(g => g.Status == GamePhase.WaitingForPlayers || g.Status == GamePhase.InProgress)
                .OrderByDescending(g => g.Id)
                .FirstOrDefault();

            if (openGame is not null)
            {
                await SelectAsync(openGame.Id);
            }
        }

        _ = RunAutoRefreshAsync(_cts.Token);
    }

    private async Task RunAutoRefreshAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        while (await timer.WaitForNextTickAsync(ct).ConfigureAwait(false))
        {
            if (_selected?.Status is not GamePhase.InProgress) continue;
            try
            {
                await InvokeAsync(async () =>
                {
                    await RefreshCoreAsync();
                    StateHasChanged();
                });
            }
            catch (Exception)
            {
                break;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    private async Task RefreshAsync()
    {
        await RunSafeAsync(RefreshCoreAsync);
    }

    private async Task CreateGameAsync()
    {
        await RunSafeAsync(async () =>
        {
            await Api.CreateGameAsync();
            await RefreshCoreAsync();
        });
    }

    private async Task OpenLobbyAsync(int id)
    {
        await RunSafeAsync(async () =>
        {
            await Api.OpenLobbyAsync(id);
            await RefreshCoreAsync();
        });
    }

    private async Task StartAsync(int id)
    {
        await RunSafeAsync(async () =>
        {
            await Api.StartGameAsync(id);
            await RefreshCoreAsync();
        });
    }

    private async Task FinishAsync(int id)
    {
        await RunSafeAsync(async () =>
        {
            await Api.FinishGameAsync(id);
            await RefreshCoreAsync();
        });
    }

    private async Task DeleteAsync(int id)
    {
        await RunSafeAsync(async () =>
        {
            await Api.DeleteGameAsync(id);
            if (_selectedId == id)
            {
                _selectedId = null;
                _selected = null;
            }

            await RefreshCoreAsync();
        });
    }

    private async Task SelectAsync(int id)
    {
        await RunSafeAsync(async () =>
        {
            _selectedId = id;
            _selected = await Api.GetGameAsync(id) ?? _games.FirstOrDefault(g => g.Id == id);
        });
    }

    private async Task RemoveLobbyPlayerAsync(int gameId, int deviceDbId)
    {
        await RunSafeAsync(async () =>
        {
            await Api.RemoveLobbyDeviceAsync(gameId, deviceDbId);
            await RefreshCoreAsync();
        });
    }

    private async Task RefreshCoreAsync()
    {
        _games.Clear();
        _games.AddRange(await Api.GetGamesAsync());
        if (_selectedId is { } id)
        {
            _selected = await Api.GetGameAsync(id) ?? _games.FirstOrDefault(g => g.Id == id);
        }
    }

    private async Task RunSafeAsync(Func<Task> work)
    {
        _error = null;
        _busy = true;
        try
        {
            await work();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static List<ScoreboardRow> BuildScoreboard(GameListItemDto game)
    {
        return game.Devices
            .Select(d => new
            {
                d.PlayerName,
                d.DeviceId,
                d.Team,
                CombatReportScore = d.CombatReportScore,
                d.AddedOn
            })
            .OrderByDescending(x => x.CombatReportScore)
            .ThenBy(x => x.AddedOn)
            .ThenBy(x => x.PlayerName)
            .Select((x, index) => new ScoreboardRow(index + 1, x.PlayerName, x.DeviceId, x.Team, x.CombatReportScore))
            .ToList();
    }

    private static int LeaderboardSpread(IReadOnlyList<ScoreboardRow> scoreboard)
    {
        if (scoreboard.Count < 2)
        {
            return 0;
        }

        return scoreboard[0].CombatReportScore - scoreboard[^1].CombatReportScore;
    }
}
